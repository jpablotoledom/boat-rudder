@startuml retro-center-entry-er

title the-retro-center - "Entry" Data Model (MongoDB collections)

skinparam backgroundColor #FAFAFA
skinparam linetype ortho
skinparam entity {
    BackgroundColor #E8F4FD
    BorderColor #1565C0
    FontColor #1A1A1A
}
skinparam note {
    BackgroundColor #FFFDE7
    BorderColor #F9A825
}

entity "entries" as ENTRIES {
    * _id : ObjectId
    --
    link : string <<unique slug>>
    type : string ("blog" | "page" | ...)
    order : int
    enabled : bool
    menu : bool
    name_id : ObjectId --> translation
    categories : ObjectId[] --> entry_categories
}

entity "header" as HEADER {
    * _id : ObjectId
    --
    entry_id : ObjectId --> entries
    image_url : string
    tittle_id : ObjectId --> translation
    summary_id : ObjectId --> translation
    author_id : ObjectId --> translation
    date : datetime
}

entity "content" as CONTENT {
    * _id : ObjectId
    --
    entry_id : ObjectId --> entries
    content_id : ObjectId --> translation
    type : string <<element type>>
    extra_data : string <<type-specific params>>
    order : int <<sort key>>
}

entity "translation" as TRANSLATION {
    * _id : ObjectId
    --
    eng : string
    esp : string
}

entity "entry_categories" as ENTRYCAT {
    * _id : ObjectId
    --
    category_id : ObjectId --> translation
}

entity "media / media_directories" as MEDIA {
    * _id : ObjectId
    --
    "(referenced by 'gallery' content blocks\nvia extra_data gallery id)"
}

ENTRIES ||--o| HEADER          : entry_id (1:1, optional)
ENTRIES ||--o{ CONTENT         : entry_id (1:N, ordered)
ENTRIES }o--|| TRANSLATION     : name_id
ENTRIES }o--o{ ENTRYCAT        : categories[]

HEADER }o--|| TRANSLATION      : tittle_id / summary_id / author_id

CONTENT }o--|| TRANSLATION     : content_id
CONTENT ..> MEDIA              : type == "gallery"

ENTRYCAT }o--|| TRANSLATION    : category_id (category name)

note right of ENTRIES
  One document per **page/route**.
  "link" is the public slug, e.g. "/blog/<link>"
  or "/page/<link>". Drives the menu (menu=true)
  and ordering (order).
end note

note right of CONTENT
  One document per **content block**.
  Rendered in "order" via a per-type,
  per-epoch template under
  html/themes/<theme>/elements/<type>/
end note

note bottom of TRANSLATION
  All user-facing text is stored once here
  and resolved per-request based on the
  "lang" cookie/query (Eng | Esp).
end note

@enduml
