@startuml sequence-http

title base-http-server - HTTP Request Sequence

skinparam backgroundColor #FAFAFA
skinparam sequenceArrowThickness 1.5
skinparam sequenceParticipant underline
skinparam sequence {
    LifeLineBackgroundColor #E3F2FD
    LifeLineBorderColor #1565C0
    ActorBackgroundColor #FFF9C4
    ActorBorderColor #F9A825
    ParticipantBackgroundColor #E8F5E9
    ParticipantBorderColor #2E7D32
}

actor Client

participant "start_stop\n(main thread)" as SS
participant "connection_thread\n(pthread)" as CT
participant "connection\n(I/O layer)" as CONN
participant "request_handler" as RH
participant "http_request_parser" as PARSER
participant "static_handler" as SH
participant "server_utils" as SU
participant "File System" as FS

== Connection Establishment ==

Client -> SS : TCP SYN (port 8080)
SS -> SS : accept() → client_socket
SS -> SS : too_many_connections(ip)?
note right: Rate limit check\nblocks burst attackers
SS -> SS : try_register_connection()
note right: Global cap: 200 concurrent
SS -> CT : pthread_create(connection_thread, {socket, root_dir, ssl=NULL})
SS -> SS : pthread_detach(tid)

== Request Reading ==

activate CT
CT -> CONN : setsockopt SO_RCVTIMEO=5s
CT -> RH : request_handler(plain_read, conn_ctx, root_dir)

activate RH
loop until "\r\n\r\n" found
    RH -> CONN : plain_read(ctx, buf, size)
    activate CONN
    CONN -> Client : recv() / read()
    CONN --> RH : bytes_read (or 0=EOF, -1=error)
    deactivate CONN
end

alt bytes_read == 0 (EOF)
    RH -> CONN : connection_close()
    RH --> CT : return
else bytes_read > 0

== Request Parsing ==

    RH -> PARSER : parse_http_request(raw_request, bytes_read)
    activate PARSER
    PARSER --> RH : HttpRequest { method, url, headers[], body }
    deactivate PARSER

    RH -> RH : extract headers\n(Content-Length, Content-Type, Cookie, User-Agent)

    alt Content-Length > 0
        loop until body complete
            RH -> CONN : plain_read(ctx, body_buf, remaining)
            CONN --> RH : bytes
        end
    end

    RH -> RH : extract client IP\n(X-Real-IP → X-Forwarded-For → getpeername)
    RH -> SU : url_decode(route)

== Routing ==

    alt GET request
        RH -> SH : handle_static_file_or_directory(ctx, root_dir, decoded_url)

        activate SH
        SH -> FS : stat(root_dir + decoded_url)

        alt file not found
            SH -> CONN : connection_write("HTTP/1.1 404 Not Found")
        else file found
            SH -> SU : get_mime_type(path)
            SH -> FS : open(path, O_RDONLY)

            SH -> CONN : connection_write(HTTP headers)
            loop until EOF
                SH -> FS : read(fd, buffer, 4096)
                SH -> CONN : connection_write(buffer, bytes_read)
            end
            SH -> FS : close(fd)
        end
        deactivate SH

    else OPTIONS request
        RH -> CONN : connection_write("HTTP/1.1 200 OK + CORS headers")

    else other method
        RH -> CONN : connection_write("HTTP/1.1 405 Method Not Allowed")
    end

end

== Connection Teardown ==

RH -> CONN : connection_close(ctx)
deactivate RH

CONN -> Client : shutdown(SHUT_RDWR) + close()

CT -> CT : unregister_connection()\n(decrement active_connections)
deactivate CT

@enduml
