@startuml sequence-http

title Boat Rudder - HTTP Request Sequence

skinparam backgroundColor #FAFAFA
skinparam sequenceArrowThickness 1.5
skinparam sequenceParticipant underline
skinparam sequence {
    LifeLineBackgroundColor #E3F2FD
    LifeLineBorderColor #1565C0
    ActorBackgroundColor #FFF9C4
    ActorBorderColor #F9A825
    ParticipantBackgroundColor #E8F5E9
    ParticipantBorderColor #2E7D32
}

actor Client

participant "server_listener\n(accept thread)" as SS
participant "connection_thread\n(pthread)" as CT
participant "connection\n(I/O layer)" as CONN
participant "http_router" as RH
participant "http_request_parser" as PARSER
participant "request_* state\n(thread-local)" as REQ
participant "analytics" as AN
participant "route handler\n(modules / orchestrator)" as MOD
participant "build_epoch_response" as RESP
participant "static_file_server" as SH
participant "File System" as FS

== Connection Establishment ==

Client -> SS : TCP SYN (http_port)
SS -> SS : accept() → client_socket
SS -> SS : too_many_connections(ip)?
note right
  under ip_table_mutex:
  ddos_rate_limit per
  ddos_rate_window_secs,
  ban 2x window, LRU
end note
SS -> SS : try_register_connection()
note right: ddos_max_connections (200)

alt rejected (rate limit or cap)
    SS -> Client : "HTTP/1.1 429 Too Many Requests"\n(best effort) + close
else accepted
    SS -> CT : pthread_create(connection_thread, {socket, root_dir, ssl=NULL})
    SS -> SS : pthread_detach(tid)

== Request Reading ==

activate CT
CT -> CONN : setsockopt SO_RCVTIMEO / SO_SNDTIMEO\n= connection_io_timeout_secs (5 s)
CT -> RH : http_route(plain_read, conn_ctx, root_dir)

activate RH
loop until header block complete
    RH -> CONN : plain_read(ctx, buf, size)
    CONN -> Client : recv()
    CONN --> RH : bytes (0 = EOF, < 0 = error)
    note right of RH
      complete on "\r\n\r\n" / "\n\n",
      on an HTTP/0.9 line,
      or after a 400 ms quiet poll()
      for a versioned line w/o terminator;
      32 KiB full → 431
    end note
end

alt Content-Length > 10 MiB
    RH -> CONN : 413 Payload Too Large
else
    alt Content-Length > 0
        loop until body complete
            RH -> CONN : plain_read(ctx, body_buf, remaining)
            CONN --> RH : bytes
        end
    end

== Parsing and per-request state ==

    RH -> PARSER : parse_http_request(raw_request, bytes_read)
    PARSER --> RH : HttpRequest { method, url, protocol, headers[], body }
    RH -> RH : client_ip (X-Real-IP / X-Forwarded-For\nonly from trusted_proxies, else peer)
    RH -> RH : url_parse + url_decode → decoded_url, params[]
    RH -> REQ : request_lang_set(Cookie, ?lang)\nrequest_path_set / request_user_set\nrequest_theme_set(Cookie, ?theme)\nrequest_charset_set(User-Agent)\nrequest_code_lines_set / request_wml_set
    RH -> AN : analytics_track_visit(method, url, UA, client_ip, resolve_epoch())
    note right of AN
      GET only, no bots,
      no static extensions,
      nothing under /dashboard;
      $inc page_visits_daily
      (+ entry_visits_daily)
    end note

== Routing ==

    alt dynamic route (/, /blog..., /page/..., /dashboard..., ...)
        RH -> RH : epoch = resolve_epoch()\nforce_epoch → ?preview_epoch → detect_epoch(UA)
        RH -> MOD : render content for epoch
        MOD --> RH : body (layout already applied)
        RH -> RESP : build_epoch_response(body, extra, epoch)
        note right of RESP
          ?lang / ?theme link tagging,
          WML pagination (860 B),
          Latin-1 for epoch 1, WML, Cello,
          Content-Type + security headers
        end note
        RESP --> RH : response
        RH -> CONN : connection_write (headers only for HEAD)
    else static path (GET/HEAD)
        RH -> SH : serve_static_file(ctx, root_dir, decoded_url, If-Modified-Since)
        activate SH
        SH -> FS : sanitize_path (realpath) + stat
        alt 304 / 200
            SH -> CONN : headers (+ 8 KiB streamed blocks)
            SH --> RH : 0
        else 403 / 404 / 500
            SH --> RH : status (nothing written)
            RH -> CONN : send_error_response() in the visitor's epoch
        end
        deactivate SH
    else OPTIONS
        RH -> CONN : 204 No Content + Allow
    else other method
        RH -> CONN : 405 (epoch error page)
    end
end

== Connection Teardown ==

RH -> CONN : connection_close(ctx)
deactivate RH
CONN -> Client : shutdown + close()

CT -> CT : unregister_connection()\n(decrement active_connections,\nsignal server_stop if 0)
deactivate CT
end

@enduml
